configuration {
    show-icons: true;
    icon-theme: "Tela";
    font: "JetBrains Mono 10";
}

* {
    bg: #FFFFFF;
    bg-sel: #0000001F;    /* Transparan halus saat di-hover/dipilih */
    fg: #1A1A1A;
    accent: #D32F2F;      /* Warna aksen merah untuk power */
    border-col: #E0E0E0;

    background-color: @bg;
    text-color: @fg;
}

window {
    /* Posisi di Pojok Kanan Bawah (Tepat di atas tombol Power Polybar) */
    location: south east;
    anchor: south east;
    x-offset: -15px;      /* Jarak dari kanan layar */
    y-offset: -55px;       /* Jarak dari bawah layar (di atas Polybar) */

    width: 220px;
    border: 1px;
    border-color: @border-col;
    border-radius: 10px;
    padding: 10px;
}

mainbox {
    children: [ listview ];
}

listview {
    lines: 4;
    columns: 1;
    spacing: 4px;
    cycle: true;
    dynamic: true;
}

element {
    padding: 8px 12px;
    border-radius: 6px;
    orientation: horizontal;
    background-color: transparent;
}

element-icon {
    size: 20px;
    margin: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
}

element selected {
    background-color: @bg-sel;
    text-color: @accent;
}

element-text selected {
    text-color: @accent;
}